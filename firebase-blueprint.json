{
  "entities": {
    "HeroVideoSlide": {
      "title": "HeroVideoSlide",
      "description": "A hero showcase video slide displayed in the storefront HeroBanner and managed in AdminDashboard settings.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier matching the document ID.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "description": "Short tab/slide label.",
          "minLength": 1,
          "maxLength": 60
        },
        "kicker": {
          "type": "string",
          "description": "Eyebrow kicker text above the headline.",
          "maxLength": 140
        },
        "headline": {
          "type": "string",
          "description": "Main hero headline.",
          "minLength": 1,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "description": "Supporting hero subtitle.",
          "maxLength": 320
        },
        "videoSrc": {
          "type": "string",
          "description": "Uploaded /media/hero-videos path, bundled /assets/videos path, or HTTPS video URL.",
          "minLength": 1,
          "maxLength": 1000
        },
        "posterSrc": {
          "type": "string",
          "description": "Fallback poster image path or HTTPS URL.",
          "maxLength": 1000
        },
        "posterAlt": {
          "type": "string",
          "description": "Accessible alt description for fallback poster.",
          "maxLength": 200
        },
        "categoryTarget": {
          "type": "string",
          "description": "Target category filter when clicking Explore.",
          "minLength": 1,
          "maxLength": 60
        },
        "featuredProductId": {
          "type": "string",
          "description": "Optional featured product ID linked in the hero CTA.",
          "maxLength": 64
        },
        "startingPrice": {
          "type": "number",
          "description": "Starting price displayed if matched product is unavailable."
        },
        "sortOrder": {
          "type": "number",
          "description": "Display order index in the hero slider."
        },
        "active": {
          "type": "boolean",
          "description": "Whether this video slide is active on the public storefront."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the slide was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the slide was last updated."
        },
        "updatedByUid": {
          "type": "string",
          "description": "UID of the authenticated admin who saved the slide.",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "label",
        "kicker",
        "headline",
        "description",
        "videoSrc",
        "posterSrc",
        "posterAlt",
        "categoryTarget",
        "featuredProductId",
        "startingPrice",
        "sortOrder",
        "active",
        "createdAt",
        "updatedAt",
        "updatedByUid"
      ]
    },
    "HeroConfig": {
      "title": "HeroConfig",
      "description": "Global hero showcase playback and active slide settings.",
      "type": "object",
      "properties": {
        "activeSlideId": {
          "type": "string",
          "description": "Preferred default hero video slide ID.",
          "maxLength": 64
        },
        "autoAdvanceSeconds": {
          "type": "number",
          "description": "Seconds between automatic hero slide transitions."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when config was last updated."
        },
        "updatedByUid": {
          "type": "string",
          "description": "UID of the authenticated admin who updated the config.",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "activeSlideId",
        "autoAdvanceSeconds",
        "updatedAt",
        "updatedByUid"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized store administrator record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Storefront phone brand category or nested sub-category managed in the Admin Dashboard.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique category identifier matching document ID.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the phone brand or sub-category.",
          "minLength": 1,
          "maxLength": 100
        },
        "slug": {
          "type": "string",
          "description": "URL-safe lowercase slug for category filtering and routing.",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "brandKey": {
          "type": "string",
          "description": "Built-in phone brand icon key or custom.",
          "enum": ["motorola", "vivo", "xiaomi", "custom"]
        },
        "featured": {
          "type": "boolean",
          "description": "Whether this category is featured on the storefront slider."
        },
        "active": {
          "type": "boolean",
          "description": "Whether this category is active and visible on the public storefront."
        },
        "parentId": {
          "type": "string",
          "description": "Parent category ID for sub-categories, or empty string for top-level phone brands.",
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "description": "Optional category description.",
          "maxLength": 1000
        },
        "googleCategory": {
          "type": "string",
          "description": "Optional Google product taxonomy category label.",
          "maxLength": 200
        },
        "seoTitle": {
          "type": "string",
          "description": "Optional SEO meta title.",
          "maxLength": 160
        },
        "seoDescription": {
          "type": "string",
          "description": "Optional SEO meta description.",
          "maxLength": 320
        },
        "image": {
          "type": "string",
          "description": "Optional HTTPS URL, local asset path, or compressed image data URI.",
          "maxLength": 300000
        },
        "shippingClass": {
          "type": "string",
          "description": "Optional shipping class label.",
          "maxLength": 80
        },
        "sortOrder": {
          "type": "number",
          "description": "Display order index among sibling categories."
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this category is one of the default store brands."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the category was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the category was last updated."
        },
        "updatedByUid": {
          "type": "string",
          "description": "UID of the authenticated admin who saved the category.",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "name",
        "slug",
        "brandKey",
        "featured",
        "active",
        "parentId",
        "description",
        "googleCategory",
        "seoTitle",
        "seoDescription",
        "image",
        "shippingClass",
        "sortOrder",
        "isDefault",
        "createdAt",
        "updatedAt",
        "updatedByUid"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated storefront customer personal profile keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 80
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "district": {
          "type": "string",
          "maxLength": 60
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "deliveryArea": {
          "type": "string",
          "enum": ["inside_dhaka", "outside_dhaka"]
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["active", "deactivated"]
        },
        "deactivatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "addresses": {
          "type": "array",
          "description": "Up to 10 saved customer delivery addresses."
        },
        "lastLoginAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "phone",
        "district",
        "address",
        "deliveryArea",
        "photoUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomerOrder": {
      "title": "CustomerOrder",
      "description": "Customer purchase order synced to Firestore for authenticated real-time order tracking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "orderNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "customerEmail": {
          "type": "string",
          "maxLength": 254
        },
        "deliveryAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "deliveryArea": {
          "type": "string",
          "enum": ["inside_dhaka", "outside_dhaka"]
        },
        "items": {
          "type": "array",
          "description": "Bounded list of ordered phone case items (1 to 50 items)."
        },
        "subtotal": {
          "type": "number"
        },
        "shippingFee": {
          "type": "number"
        },
        "discountAmount": {
          "type": "number"
        },
        "couponCode": {
          "type": "string",
          "maxLength": 40
        },
        "total": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cod", "bkash", "nagad", "card"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["paid", "pending", "failed"]
        },
        "fulfillmentStatus": {
          "type": "string",
          "enum": ["pending", "confirmed", "shipped", "delivered", "cancelled"]
        },
        "transactionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "source": {
          "type": "string",
          "enum": ["Web", "POS"]
        },
        "channel": {
          "type": "string",
          "maxLength": 80
        },
        "courierProvider": {
          "type": "string",
          "maxLength": 40
        },
        "courierTrackingCode": {
          "type": "string",
          "maxLength": 80
        },
        "courierConsignmentId": {
          "type": "string",
          "maxLength": 80
        },
        "courierStatus": {
          "type": "string",
          "maxLength": 32
        },
        "confirmedAt": {
          "type": "string",
          "maxLength": 64
        },
        "shippedAt": {
          "type": "string",
          "maxLength": 64
        },
        "deliveredAt": {
          "type": "string",
          "maxLength": 64
        },
        "createdAtIso": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAtIso": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "orderNumber",
        "customerName",
        "customerPhone",
        "customerEmail",
        "deliveryAddress",
        "deliveryArea",
        "items",
        "subtotal",
        "shippingFee",
        "discountAmount",
        "couponCode",
        "total",
        "paymentMethod",
        "paymentStatus",
        "fulfillmentStatus",
        "transactionId",
        "source",
        "channel",
        "courierProvider",
        "courierTrackingCode",
        "courierConsignmentId",
        "courierStatus",
        "confirmedAt",
        "shippedAt",
        "deliveredAt",
        "createdAtIso",
        "updatedAtIso",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/heroVideos/{slideId}": {
      "schema": { "$ref": "#/entities/HeroVideoSlide" },
      "description": "Hero section video slides managed by admins and read by the public storefront HeroBanner."
    },
    "/heroConfig/{configId}": {
      "schema": { "$ref": "#/entities/HeroConfig" },
      "description": "Hero carousel playback settings (default slide ID and auto-advance timing)."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Verified store administrator records."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Hierarchical store categories and brand sub-categories managed by admins and read by the public storefront."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer personal profiles readable and writable strictly by the owning Firebase Auth user."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/CustomerOrder" },
      "description": "Authenticated customer purchase orders synced to Firestore for real-time order status and courier tracking."
    }
  }
}
